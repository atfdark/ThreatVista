# Frontend environment — copy to `frontend/.env` and adjust.
# Vite exposes these via import.meta.env.VITE_* at dev/build time.

# Backend API root this dashboard talks to. For a LAN demo, point it at the
# SOC server's LAN address (the server laptop's IPv4 from `ipconfig`):
#   VITE_API_BASE_URL=http://192.168.1.100:8000/api
# The WebSocket live feed is derived from the same base automatically.
# Local development: use Vite's proxy so localhost and LAN access both work.
VITE_API_BASE_URL=/api
