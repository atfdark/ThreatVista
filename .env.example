# ThreatVista runtime configuration — copy to `.env` and adjust.

# JWT signing secret. MUST be a long random value outside local demos.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
THREATVISTA_SECRET_KEY=change-me-to-a-long-random-secret

# ---- LAN demo (hackathon) settings ----
# Host/port the FastAPI server binds. 0.0.0.0 exposes it on every interface so
# teammates' endpoint agents and dashboards can reach it over Wi-Fi.
THREATVISTA_HOST=0.0.0.0
THREATVISTA_PORT=8000

# LAN mode: when 1 (default) the API accepts browser requests from ANY origin,
# so teammates can open the dashboard at http://<server-ip>:5173 with no CORS
# allow-list. Set to 0 to restrict CORS to THREATVISTA_CORS_ORIGINS below.
THREATVISTA_LAN=1

# Comma-separated browser origins allowed to call the API (CORS). Only used
# when THREATVISTA_LAN=0.
THREATVISTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.100:5173

# Optional shared secret for endpoint agents. When set, POST /api/events,
# /api/agent/register, and /api/agent/heartbeat require an X-Agent-Key header.
THREATVISTA_AGENT_KEY=

# ---- Endpoint agent (read from the environment on each machine) ----
# Which employee this machine belongs to. The agent registers its device
# profile against this email at startup.
AGENT_EMPLOYEE_EMAIL=rahul.sharma@threatvista.com

# How often (seconds) the agent sends a heartbeat to stay "online".
AGENT_HEARTBEAT_SECONDS=30

# Backend the agent reports to. For a LAN demo point this at the SOC server's
# LAN address (the server laptop's IPv4 from `ipconfig`), e.g.
#   BACKEND_URL=http://192.168.1.100:8000
# Accepts either the API root (with /api) or the bare server root.
BACKEND_URL=http://127.0.0.1:8000
